# connect to local Stoat instance
VITE_HOST=localhost:4173
VITE_API_URL=http://localhost:14702

# Dev server overrides (applies to default instance)
# VITE_DEV_WS_URL=ws://localhost:14703
# VITE_DEV_MEDIA_URL=http://localhost:14704
# VITE_DEV_PROXY_URL=http://localhost:14705
# VITE_DEV_GIFBOX_URL=http://localhost:14706

# specify Sentry DSN
VITE_SENTRY_DSN=
VITE_SENTRY_TUNNEL=
# open this server on app start instead of the home page
# VITE_DEFAULT_SERVER_ID=

# panel rooms: homelab bridge serving manifests/actions (channel description "[panel]")
# VITE_PANEL_BRIDGE_URL=http://localhost:8787
# comma-separated origins panel iframes may embed
# VITE_PANEL_IFRAME_ORIGINS=https://grafana.lan,https://homeassistant.lan
